{
  "name": "base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "cd server && uvicorn main:app --host 127.0.0.1 --port ${BACKEND_PORT:-8000} --reload",
    "dev:all": "concurrently -k -n web,api -c blue,green \"pnpm dev\" \"pnpm dev:server\"",
    "build": "tsc -b && vite build",
    "start": "cd server && uvicorn main:app --host 127.0.0.1 --port ${BACKEND_PORT:-8000}",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "lenis": "^1.1.20",
    "gsap": "^3.12.5",
    "@use-gesture/react": "^10.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.0"
  }
}
